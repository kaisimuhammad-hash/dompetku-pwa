# ---- Wajib diisi ----
# Kode akses dashboard (minimal 6 karakter). Simpan baik-baik.
APP_PASSCODE=ganti-dengan-kode-rahasia

# Kunci acak untuk menandatangani sesi login. Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=ganti-dengan-string-acak-panjang

# ---- Database ----
# Kosongkan untuk mode lokal (data disimpan di ./data/pglite).
# Untuk online, isi connection string dari Neon (postgresql://user:pass@host/db?sslmode=require)
DATABASE_URL=

# ---- Bot Telegram ----
# Opsional. Cara termudah: tempel token dari @BotFather di dashboard → Pengaturan → Bot Telegram.
# Variabel ini hanya untuk mengelola token dari server; token dashboard dipakai lebih dulu.
TELEGRAM_BOT_TOKEN=

# URL publik aplikasi (tanpa garis miring di akhir). Opsional saat di Render
# karena otomatis dibaca dari RENDER_EXTERNAL_URL. Wajib di VPS/server sendiri agar bot memakai webhook.
# Contoh: https://dompetku.onrender.com
PUBLIC_URL=

# Rahasia header webhook Telegram (buat string acak)
WEBHOOK_SECRET=ganti-dengan-string-acak

# ---- Opsional ----
PORT=3000
TZ=Asia/Jakarta
# true bila dashboard diakses lewat HTTPS di belakang proxy (otomatis aktif bila PUBLIC_URL https)
COOKIE_SECURE=
# Jarak pengiriman backup otomatis lewat Telegram (hari). Default 7.
BACKUP_INTERVAL_DAYS=7
